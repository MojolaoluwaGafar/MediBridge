{
  "name": "medibridge",
  "version": "0.1.0",
  "description": "MediBridge monorepo: Client (React) and Server (Express API)",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @medibridge/server\" \"npm run dev -w @medibridge/client\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev -w @medibridge/server",
    "dev:client": "npm run dev -w @medibridge/client"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "license": "ISC"
}
