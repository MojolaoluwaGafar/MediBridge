PORT=5000
DB_CONNECTION_URL=mongo_url
CORS_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173
# GROQ_MODEL=llama-3.2-3b-instruct
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Optional: a smaller, faster model for safety triage (defaults to GROQ_MODEL)
# GROQ_TRIAGE_MODEL=llama-3.1-8b-instant
# Shown in emergency replies, e.g. 112. Leave empty to say "your local emergency number".
HOSPITAL_EMERGENCY_NUMBER=
DB_PASSWORD=
DB_USERNAME=
JWT_SECRET_KEY=
EMAIL_SERVICE=
# APP_NAME=MediBridge
APP_EMAIL=
APP_PASSWORD=
BREVO_API_KEY=replace_with_brevo_api_key
EMAIL_FROM=you@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Logging: trace | debug | info | warn | error | fatal (default: debug in dev, info in production)
LOG_LEVEL=

# Proxies in front of the server (Render = 1). Used so rate limiting sees the real client IP.
TRUST_PROXY_HOPS=1

# Database name (default hospitalDB). Point server and seeds at e.g. hospitalDB_test to keep test data separate.
DB_NAME=
# Password for the seeded test patient PTEST001 (npm run seed:patient). Default: TestPatient@123
TEST_PATIENT_PASSWORD=

# Phone numbers typed without a country code are read as this country (ISO code). Default: NG
DEFAULT_PHONE_COUNTRY=NG
# SMS delivery for activation / reset codes: termii | twilio | console | none
# Default: console in development (codes printed to the server log), none in production.
SMS_PROVIDER=
# Termii (https://termii.com) - base URL is shown on your Termii dashboard
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_CHANNEL=dnd
# Twilio (https://twilio.com) - set a Messaging Service SID or a From number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
